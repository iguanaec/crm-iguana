generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  todo
  in_progress
  review
  done
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum ClientStatus {
  active
  inactive
  archived
}

enum ObjectiveType {
  revenue
  completion
  quality
  custom
}

enum NotificationType {
  daily_digest
  deadline_approaching
  priority_changed
  task_assigned
  bottleneck_detected
}

enum IntegrationPlatform {
  discord
  slack
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  name         String

  /// Zona horaria IANA; decide cuando se envia el resumen diario.
  timezone   String @default("America/Bogota")
  /// Hora local (0-23) del resumen diario.
  digestHour Int    @default(9)

  notifyDailyDigest Boolean @default(true)
  notifyDeadlines   Boolean @default(true)
  notifyPriority    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients       Client[]
  projects      Project[]
  objectives    Objective[]
  createdTasks  Task[]              @relation("TaskCreator")
  assignedTasks Task[]              @relation("TaskAssignee")
  taskChanges   TaskHistory[]
  notifications Notification[]
  integrations  IntegrationConfig[]
  suggestions   AiSuggestion[]

  @@map("users")
}

model Client {
  id     String @id @default(uuid())
  userId String

  name    String
  email   String?
  phone   String?
  company String?
  notes   String?
  status  ClientStatus @default(active)
  tags    String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId])
  @@index([userId, status])
  @@map("clients")
}

model Project {
  id       String  @id @default(uuid())
  userId   String
  clientId String?

  name        String
  description String?
  status      ProjectStatus @default(active)
  color       String        @default("#3b82f6")
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pipelines  Pipeline[]
  tasks      Task[]
  objectives Objective[]

  @@index([userId])
  @@index([userId, status])
  @@index([clientId])
  @@map("projects")
}

model Pipeline {
  id        String @id @default(uuid())
  projectId String

  name     String
  color    String?
  position Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
  @@map("pipelines")
}

model Task {
  id         String @id @default(uuid())
  projectId  String
  pipelineId String

  title       String
  description String?
  status      TaskStatus @default(todo)

  /// Prioridad manual 1-5 que fija la persona. El asistente no la sobreescribe.
  priority Int @default(3)

  startDate      DateTime? @db.Date
  dueDate        DateTime? @db.Date
  estimatedHours Float?
  actualHours    Float?

  assignedToId String?
  createdById  String

  parentTaskId String?
  /// IDs de tareas que deben terminar antes que esta.
  dependsOn    String[] @default([])
  objectiveId  String?

  labels   String[] @default([])
  position Int      @default(0)

  /// Score 0-10 del motor de priorizacion. Independiente de `priority`.
  aiPriorityScore     Float?
  /// Los cuatro factores normalizados que produjeron el score.
  aiPriorityFactors   Json?
  aiPriorityUpdatedAt DateTime?
  /// Texto original si la tarea nacio del parser de lenguaje natural.
  generatedFromPrompt String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  assignedTo User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User           @relation("TaskCreator", fields: [createdById], references: [id])
  parentTask Task?          @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks   Task[]         @relation("Subtasks")
  objective  Objective?     @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  history    TaskHistory[]
  notifications Notification[]
  suggestions   AiSuggestion[]

  @@index([projectId, status])
  @@index([pipelineId, position])
  @@index([assignedToId, status])
  @@index([dueDate])
  @@index([aiPriorityScore(sort: Desc)])
  @@index([parentTaskId])
  @@index([objectiveId])
  @@map("tasks")
}

model Objective {
  id        String  @id @default(uuid())
  userId    String
  projectId String?

  title       String
  description String?
  goalType    ObjectiveType @default(custom)
  targetValue Float?
  currentValue Float        @default(0)
  unit        String?
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  /// Un objetivo critico eleva el factor de impacto de sus tareas al maximo.
  isCritical  Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([userId])
  @@index([projectId])
  @@map("objectives")
}

model TaskHistory {
  id          String  @id @default(uuid())
  taskId      String
  changedById String?

  /// created | status_changed | priority_changed | due_date_changed | assigned
  changeType String
  field      String?
  oldValue   String?
  newValue   String?

  createdAt DateTime @default(now())

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("task_history")
}

model Notification {
  id     String @id @default(uuid())
  userId String

  type    NotificationType
  title   String
  message String

  taskId    String?
  projectId String?

  isRead Boolean   @default(false)
  readAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model IntegrationConfig {
  id     String @id @default(uuid())
  userId String

  platform IntegrationPlatform
  /// URL del webhook entrante. Se enmascara al devolverla al cliente.
  webhookUrl String

  isActive          Boolean            @default(true)
  notificationTypes NotificationType[] @default([])

  lastDeliveryAt DateTime?
  lastDeliveryOk Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("integration_configs")
}

model AiSuggestion {
  id     String @id @default(uuid())
  userId String

  /// prioritization | task_generation | next_task | bottleneck
  suggestionType String
  content        String

  taskId String?

  /// null = pendiente, true = aceptada, false = descartada.
  isAccepted Boolean?
  acceptedAt DateTime?

  confidence Float?
  metadata   Json?

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, suggestionType, createdAt(sort: Desc)])
  @@map("ai_suggestions")
}
