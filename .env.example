# Base de datos (coincide con docker-compose.yml).
# En local las dos direcciones son la misma.
DATABASE_URL="postgresql://crm:crm_local_dev@localhost:5432/crm_iguana?schema=public"
DIRECT_URL="postgresql://crm:crm_local_dev@localhost:5432/crm_iguana?schema=public"

# Con Supabase son distintas: la app usa el pooler y las migraciones la directa,
# porque el pooler no admite las sentencias que estas necesitan.
# DATABASE_URL="postgresql://postgres.xxxx:CLAVE@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxx:CLAVE@aws-0-region.pooler.supabase.com:5432/postgres"

# Backend
PORT=5000
NODE_ENV=development

# Auth - genera uno con: openssl rand -base64 32
JWT_SECRET="cambia_esto_por_un_secret_aleatorio_largo"
JWT_EXPIRES_IN="7d"

# Origen del frontend, separado por comas. En local se puede dejar vacío;
# al desplegar, fíjalo a la dirección real del sitio.
# CORS_ORIGIN="https://mi-crm.up.railway.app"

# Frontend (Vite). En local se deja vacío: el proxy de Vite reenvía al backend.
# Al desplegar por separado, apunta a la API: https://mi-api.up.railway.app/api/v1
# VITE_API_URL=""

# Zona horaria para notificaciones y resumen diario
DEFAULT_TIMEZONE="America/Bogota"

# Integraciones opcionales: se configuran desde la UI, no aqui.
# No se requiere ninguna API paga.
