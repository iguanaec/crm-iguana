# Base de datos (coincide con docker-compose.yml)
DATABASE_URL="postgresql://crm:crm_local_dev@localhost:5432/crm_iguana?schema=public"

# Backend
PORT=5000
NODE_ENV=development

# Auth - genera uno con: openssl rand -base64 32
JWT_SECRET="cambia_esto_por_un_secret_aleatorio_largo"
JWT_EXPIRES_IN="7d"

# Frontend (Vite)
VITE_API_URL="http://localhost:5000/api/v1"

# Zona horaria para notificaciones y resumen diario
DEFAULT_TIMEZONE="America/Bogota"

# Integraciones opcionales: se configuran desde la UI, no aqui.
# No se requiere ninguna API paga.
